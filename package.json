{
  "name": "olhelper",
  "version": "0.1.0",
  "private": true,
  "description": "Delegated Outlook case-routing add-in",
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "manifest:hosted": "node scripts/create-hosted-manifest.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/office-js": "^1.0.607",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.2",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.10.2",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "webpack": "^5.110.0",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
