{
  "name": "olhelper",
  "version": "0.1.0",
  "private": true,
  "description": "Delegated Outlook case-routing add-in",
  "scripts": {
    "build": "webpack --mode production",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate appPackage/manifest.json",
    "manifest:hosted": "node scripts/create-hosted-manifest.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/office-js": "^1.0.611",
    "adm-zip": "0.6.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.5.0",
    "fs-extra": "^11.4.1",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.10.2",
    "office-addin-manifest": "^2.1.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "webpack": "^5.110.0",
    "webpack-cli": "^7.2.2"
  },
  "overrides": {
    "adm-zip": "$adm-zip",
    "js-yaml": "5.4.1",
    "qs": "6.16.0"
  }
}
